# Production build: point the frontend at the deployed backend.
# In Vercel → Project → Settings → Environment Variables, add:
#   VITE_API_URL = https://<your-render-backend>.onrender.com/api
#
# Locally you do NOT need this — the Vite dev server proxies /api to
# http://localhost:8000 (see vite.config.js).
VITE_API_URL=https://womenrise-backend.onrender.com/api
